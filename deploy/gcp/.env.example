# Copy to .env on the VM (deploy-vm.sh writes it for you).
#
# The image to run. Cloud Build pushes it here; the VM pulls it with its own
# service account.
IMAGE=us-central1-docker.pkg.dev/CHANGE_ME_PROJECT/bggo/demo:latest

# Where Caddy answers for this host.
#
#   http://<vm static ip>            default — no DNS needed, plain HTTP
#   bggo.sophon1.dedyn.io            a NEW subdomain pointing at this VM; Caddy
#                                    then gets a real Let's Encrypt certificate
#
# Never the printed-QR hostname (`sophon1.dedyn.io`): that one belongs to the
# homelab, which keeps serving the boarding passes. deploy-vm.sh refuses it.
SITE_ADDRESS=http://CHANGE_ME_VM_IP
