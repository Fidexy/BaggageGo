# Copy to .env next to failover/compose.yaml.
#
# The frozen name, exactly as printed inside every QR. Nothing about the pass
# changes; the A record for this name points at the front-door VM instead of the
# homelab.
SITE_HOST=sophon1.dedyn.io

# How the front door reaches the homelab. This MUST be a name (not a bare IP):
# the home IP is dynamic, and whatever updates it (the router's DDNS client)
# should keep updating THIS record now, e.g. home.sophon1.dedyn.io -> <home ip>.
HOMELAB_UPSTREAM=https://home.sophon1.dedyn.io

# The name NPM on the homelab holds its certificate for — the hop presents this
# in SNI so proxy host 1 matches and the certificate validates. No NPM change.
HOMELAB_SNI=sophon1.dedyn.io

# The cloud copy, on this compose network.
FALLBACK_UPSTREAM=demo:8091

# The demo image (same one the plain stack uses).
IMAGE=us-central1-docker.pkg.dev/CHANGE_ME_PROJECT/bggo/demo:latest
